{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "plugin": ["@dietrichgebert/ponytail"],
  "permission": {
    "bash": {
      "git *": "allow",
      "bash -n *": "allow",
      "chmod +x *": "allow",
      "mkdir *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "du *": "allow",
      "df *": "allow",
      "lsblk *": "allow",
      "mountpoint *": "allow",
      "crontab -l*": "allow",
      "docker ps *": "allow",
      "docker inspect *": "allow",
      "docker logs *": "allow",
      "journalctl *": "allow",
      "systemctl status *": "allow",
      "systemctl list-timers *": "allow",
      "systemctl list-units *": "allow",
      "systemctl is-active *": "allow",
      "systemctl is-enabled *": "allow",
      "borg --version": "allow",
      "borg list *": "allow",
      "borg info *": "allow",
      "rclone version": "allow",
      "rclone listremotes": "allow",
      "rclone lsd *": "allow",
      "rclone ls *": "allow",
      "rclone size *": "allow",
      "*": "ask"
    }
  }
}
